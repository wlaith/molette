{
  "name": "molette",
  "version": "0.1.2",
  "description": "React controls designed to be shown: sliders, steppers, toggles and keys on a golden-ratio grid, for creative coding and p5.js sketches.",
  "keywords": [
    "creative-coding",
    "p5js",
    "generative",
    "slider",
    "controls",
    "gui",
    "react",
    "design-system",
    "golden-ratio"
  ],
  "author": "Laith Alwazani",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite demo --config demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "oxlint src demo test",
    "build:demo": "vite build demo --config demo/vite.config.ts --base ./"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlaith/molette.git"
  },
  "homepage": "https://github.com/wlaith/molette#readme",
  "bugs": {
    "url": "https://github.com/wlaith/molette/issues"
  }
}
